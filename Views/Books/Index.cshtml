@using TheLight_JoneBookShop_WebMVC.helper
@model IEnumerable<TheLight_JoneBookShop_WebMVC.Models.Book>
@{
    ViewData["Title"] = "Trang chủ | JoneBookShop";
}
@section Scripts {
    <script>
        // Slider Tự Động (3 giây)
        let slideIndex = 0;
        const slides = document.getElementsByClassName("hero-slide");
        function showSlides() {
            for (let i = 0; i < slides.length; i++) {
                slides[i].style.display = "none";
            }
            slideIndex++;
            if (slideIndex > slides.length) { slideIndex = 1; }
            slides[slideIndex - 1].style.display = "block";
            setTimeout(showSlides, 3000); // 3s
        }
        showSlides();
    </script>
}
<div class="products-catagories-area clearfix">
    <div class="amado-pro-catagory clearfix">

        <!-- SLIDER (4 ảnh) -->
        <div class="hero-slider single-products-catagory clearfix">
            <div class="hero-slide slide-fade">
                <img src="~/img/slider1.jpg" alt="Slide 1">
                <div class="slide-content">Khám phá kho tàng sách mọi thể loại</div>
            </div>
            <div class="hero-slide slide-fade">
                <img src="~/img/slider2.jpg" alt="Slide 2">
                <div class="slide-content">Ưu đãi đặc biệt - Giảm đến 50%</div>
            </div>
            <div class="hero-slide slide-fade">
                <img src="~/img/slider3.jpg" alt="Slide 3">
                <div class="slide-content">Sách hay, bạn đồng hành lý tưởng</div>
            </div>
            <div class="hero-slide slide-fade">
                <img src="~/img/slider4.jpg" alt="Slide 4">
                <div class="slide-content">JoneBookShop - Đọc để mở rộng chân trời</div>
            </div>
        </div>
        <!-- PHẦN GIỚI THIỆU -->
        <section class="intro-section single-products-catagory clearfix">
            <h2>Chào Mừng Đến Với JoneBookShop</h2>
            <p>
                Tại JoneBookShop, chúng tôi tin rằng mỗi cuốn sách là một chuyến phiêu lưu.
                Từ văn học kinh điển đến truyện tranh hiện đại, từ kỹ năng sống đến khoa học viễn tưởng,
                chúng tôi luôn nỗ lực mang đến cho bạn trải nghiệm đọc phong phú và đa dạng nhất.
            </p>
            <p>
                Hãy bắt đầu hành trình khám phá thế giới qua những trang sách tuyệt vời tại JoneBookShop.
            </p>
        </section>
        <!-- HIGHLIGHT BOXES (VD: DỊCH VỤ, ƯU ĐÃI, HỖ TRỢ) -->
        <div class="highlight-boxes single-products-catagory clearfix">
            <div class="highlight-box">
                <i class="bi bi-truck"></i>
                <h3>Giao Hàng Miễn Phí</h3>
                <p>Miễn phí vận chuyển cho mọi đơn hàng trên 300.000 VNĐ.</p>
            </div>
            <div class="highlight-box">
                <i class="bi bi-gift"></i>
                <h3>Ưu Đãi Thường Xuyên</h3>
                <p>Mã giảm giá mỗi ngày đầy hấp dẫn.</p>
            </div>
            <div class="highlight-box">
                <i class="bi bi-headset"></i>
                <h3>Hỗ Trợ 24/7</h3>
                <p>Đội ngũ hỗ trợ nhiệt tình, giải đáp mọi thắc mắc về sách và dịch vụ.</p>
            </div>
        </div>

    </div>
</div>
<!-- Product Catagories Area End -->