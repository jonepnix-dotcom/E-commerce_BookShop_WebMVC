@model TheLight_JoneBookShop_WebMVC.DTO.CheckoutVM
@{
    ViewData["Title"] = "Thanh Toán | JoneBookShop";
    Layout = "_LayoutCustomer";
}
@section Styles {
    <link href="~/css/Checkout.css" rel="stylesheet" />
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Khởi tạo jQuery Validation
            $("form").validate({
                onfocusout: function (element) { this.element(element); },
                onkeyup: function (element) { this.element(element); }
            });

            // Lắng nghe sự kiện 'input' để kiểm tra lại validation
            $("input, textarea").on("input", function () {
                $(this).valid();
            });

            // Kiểm tra lại validation cho Address nếu nó đã có sẵn dữ liệu từ Model
            var addressField = $("#Address");
            if (addressField.val().trim() !== "") {
                addressField.valid();
            }

            // Lắng nghe sự kiện input trên textarea #Address
            $("#Address").on("input", function () {
                // Disable button VNPay khi có thay đổi trong textarea
                $(".vnpay").prop("disabled", true);
            });
            $("#voucher").on("input", function () {
                // Disable button VNPay khi có thay đổi trong textarea
                $(".vnpay").prop("disabled", true);
            });

           
        });
        function updateAddress(selectedAddress) {
            var addressField = $("#Address");
            addressField.val(selectedAddress); // Cập nhật giá trị
            addressField.valid(); // Kiểm tra lại validation
        }
        document.addEventListener("input", function (event) {
            if (event.target.tagName.toLowerCase() === "textarea") {
                event.target.style.height = "auto";
                event.target.style.height = event.target.scrollHeight + "px";
            }
        });
        // Hiệu ứng tia lazer (sao băng)
        const canvas = document.getElementById('laserCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        let lasers = [];
        let lastSpawn = 0;
        const spawnInterval = 200; // khoảng thời gian giữa các tia (ms)

        function spawnLaser() {
            const x = Math.random() * canvas.width;
            const y = Math.random() * canvas.height;
            const angle = Math.random() * Math.PI * 2;
            const speed = 100 + Math.random() * 150; // tốc độ (px/giây)
            const length = 50 + Math.random() * 200;
            const life = 1000 + Math.random() * 3000; // thời gian sống (ms)
            const colorChoices = ["#ff0000", "#00ff00", "#0000ff", "#ffff00", "#ff00ff", "#00ffff"];
            const color = colorChoices[Math.floor(Math.random() * colorChoices.length)];
            return { x, y, angle, speed, length, life, age: 0, color };
        }

        let lastTime = performance.now();
        function animateLasers(time) {
            const deltaTime = time - lastTime;
            lastTime = time;

            if (time - lastSpawn > spawnInterval) {
                lasers.push(spawnLaser());
                lastSpawn = time;
            }

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            for (let i = lasers.length - 1; i >= 0; i--) {
                let laser = lasers[i];
                laser.age += deltaTime;
                if (laser.age > laser.life) {
                    lasers.splice(i, 1);
                    continue;
                }
                const distance = (laser.speed * deltaTime) / 1000;
                laser.x += Math.cos(laser.angle) * distance;
                laser.y += Math.sin(laser.angle) * distance;

                const tailX = laser.x - Math.cos(laser.angle) * laser.length;
                const tailY = laser.y - Math.sin(laser.angle) * laser.length;
                let alpha = 1 - (laser.age / laser.life);
                ctx.globalAlpha = alpha;

                // Vẽ đuôi với gradient tuyến tính: đầu sáng, đuôi mờ
                let grad = ctx.createLinearGradient(laser.x, laser.y, tailX, tailY);
                grad.addColorStop(0, laser.color);
                grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
                ctx.strokeStyle = grad;
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(laser.x, laser.y);
                ctx.lineTo(tailX, tailY);
                ctx.stroke();

                // Vẽ phần đầu (head) của tia sao băng với hiệu ứng radial gradient
                let headRadius = 4;
                let radialGrad = ctx.createRadialGradient(laser.x, laser.y, 0, laser.x, laser.y, headRadius);
                radialGrad.addColorStop(0, laser.color);
                radialGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
                ctx.fillStyle = radialGrad;
                ctx.beginPath();
                ctx.arc(laser.x, laser.y, headRadius, 0, Math.PI * 2, false);
                ctx.fill();
            }
            ctx.globalAlpha = 1;
            requestAnimationFrame(animateLasers);
        }
        requestAnimationFrame(animateLasers);


        //Map Script
        let map;
        let marker;
        let selectedAddress = "";

        function openMapModal() {
            $(".vnpay").prop("disabled", true);
            document.getElementById("mapModalAddress").style.display = "flex";
            initMap();
        }

        function closeMapModal() {
            document.getElementById("mapModalAddress").style.display = "none";
        }

        function initMap() {
            if (!map) {
                map = L.map("map").setView([10.7769, 106.7009], 13); // Mặc định: TP.HCM

                // Thêm tile từ OpenStreetMap
                L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    attribution: '© OpenStreetMap contributors'
                }).addTo(map);

                // Sự kiện click để chọn vị trí
                map.on("click", function (e) {
                    placeMarker(e.latlng);
                });
            }
        }

        function placeMarker(latlng) {
            if (marker) {
                marker.remove();
            }
            marker = L.marker(latlng).addTo(map);
            // Lấy địa chỉ từ Nominatim API
            fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latlng.lat}&lon=${latlng.lng}`)
                .then(response => response.json())
                .then(data => {
                    if (data.display_name) {
                        selectedAddress = data.display_name;
                        document.getElementById("Address").value = selectedAddress;
                        updateAddress(selectedAddress);
                    } else {
                        selectedAddress = "Không tìm thấy địa chỉ!";
                    }
                });
        }

        function confirmLocation() {
            closeMapModal();
        }
        function confirmAddress() {          
            RefreshBillCart(document.getElementById('Address').value, document.getElementById('voucher').value);
        }
        function CancelVoucher() {
            $('#voucher').val("");
            $('#infoVoucher').empty();
            RefreshBillCart(document.getElementById('Address').value, document.getElementById('voucher').value);
        }
        function RefreshBillCart(address, VoucherCode) {
            $.ajax({
                url: '/ShopCart/RefreshBill',
                type: 'POST',
                data: { address: address, VoucherCode: VoucherCode },
                success: function (response) {
                    if (response.success) {
                        $(".vnpay").prop("disabled", false);
                        $('#shippingText').text(response.shipfee);
                        $('#total').text(Number(response.totalPayment).toLocaleString('vi-VN') + " VND");
                        $("#Amount").val(response.totalPayment);
                        $('#vouchertext').text(response.vouchervalue);
                        $('#infoVoucher').text(response.mess);
                    }
                },
            });
        }

        function goToCart() {
            window.location.href = '@Url.Action("Index", "ShopCart")';
        }
    </script>
}
<!-- Canvas hiệu ứng tia lazer -->
<div id="mapModalAddress" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <h2>Chọn vị trí trên bản đồ</h2>
        <div id="map" style="height: 400px; width: 100%;"></div>
        <button onclick="confirmLocation()">Xác nhận</button>
        <button onclick="closeMapModal()">Đóng</button>
    </div>
</div>
<canvas id="laserCanvas"></canvas>
<div class="header-image-container">
    <!-- Banner Futuristic Checkout SVG -->
    <svg width="600" height="200" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color:#0f0c29;stop-opacity:1" />
                <stop offset="50%" style="stop-color:#302b63;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#24243e;stop-opacity:1" />
            </linearGradient>
            <filter id="glow">
                <feGaussianBlur stdDeviation="4" result="coloredBlur" />
                <feMerge>
                    <feMergeNode in="coloredBlur" />
                    <feMergeNode in="SourceGraphic" />
                </feMerge>
            </filter>
        </defs>
        <!-- Nền gradient -->
        <rect width="600" height="200" fill="url(#grad)" />
        <!-- Text tiêu đề với hiệu ứng glow -->
        <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="#00ffff" font-size="32" font-family="Orbitron, sans-serif" filter="url(#glow)">
            CHECKOUT
        </text>
        <!-- Đường nét phá cách (dashed line) kèm hiệu ứng glow -->
        <line x1="50" y1="150" x2="550" y2="150" stroke="#00ffff" stroke-width="2" stroke-dasharray="5,5" filter="url(#glow)" />
        <!-- Hình tròn nhỏ với hiệu ứng glow -->
        <circle cx="300" cy="150" r="4" fill="#ff00ff" filter="url(#glow)" />
    </svg>
</div>
<div class="content">


    <form asp-action="Checkout" asp-controller="ShopCart" method="post">
        <input id="Amount" type="hidden" asp-for="Amount" />
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" id="Name" asp-for="Name">

        <h2>Thông tin mua hàng</h2>
        <div class="form-group">
            <label for="Name" asp-for="Name"></label>
            <input type="text" id="Name" asp-for="Name" value="@Model.Name" disabled>
        </div>
        <div class="form-group">
            <label for="Email" asp-for="Email"></label>
            <input type="text" id="Email" asp-for="Email" placeholder="Nhập email" value="@Model.Email">
        </div>
        <div class="form-group">
            <label for="Address" asp-for="Address"></label>
            <textarea type="text" id="Address" asp-for="Address" placeholder="Nhập địa chỉ giao hàng">@Model.Address</textarea>
            <span asp-validation-for="Address" id="infoAddress"></span>
        </div>
        <div class="form-group">
            <button class="gradient-btn" type="button" onclick="confirmAddress()">Xác nhận địa chỉ</button>
            <button class="gradient-btn" type="button" onclick="openMapModal()">Chọn địa chỉ</button>
        </div>
        <h2>Mã giảm giá</h2>
        <div class="form-group ">
            <input type="text" id="voucher" placeholder="Nhập mã giảm giá">
            <label id="infoVoucher"></label>
        </div>
        <div class="form-group">
            <button class="gradient-btn" type="button" onclick="confirmAddress()">Áp dụng mã giảm giá</button>
            <button class="gradient-btn" type="button" onclick="CancelVoucher()">Bỏ mã giảm giá</button>
        </div>

        <div class="total-breakdown">
            <p>Tiền mua hàng: <span id="basePrice">@ViewBag.basePrice</span></p>
            <p>Thuế: <span id="tax">@ViewBag.tax</span></p>
            <p>Phí vận chuyển: <span id="shippingText">@ViewBag.Shipfee</span></p>
            <p>Giảm giá: <span id="vouchertext">0 VND</span></p>
            <hr>
            <p><strong>Tổng cộng: <span id="total">@ViewBag.totalPayment</span></strong></p>
        </div>

        <h2>Chọn phương thức thanh toán</h2>
        <div class="payment-buttons">
            <button class="vnpay" type="submit">
                VNPay
            </button>
        </div>

        <div class="form-group">
            <button type="button" class="back-to-cart" onclick="goToCart()"> Quay về giỏ hàng</button>
        </div>
    </form>
</div>