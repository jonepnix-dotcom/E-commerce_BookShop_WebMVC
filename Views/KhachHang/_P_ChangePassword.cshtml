@model TheLight_JoneBookShop_WebMVC.DTO.ChangePasswordVM
<form asp-action="ChangePassword" method="post">
    <div id="changePasswordModal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <h2>Bạn có muốn thay đổi mật khẩu?</h2>
            <div class="form-group">
                <label>
                    <i class="fas fa-key"></i>
                    <label asp-for="Password"></label>
                </label>
                <input asp-for="Password" id="Password" type="password" value="@Model.Password" />

            </div>
            <!-- Form Group: RePassword -->
            <div class="form-group">
                <label>
                    <i class="fas fa-key"></i>
                    <label asp-for="RePassword"></label>
                </label>
                <input asp-for="RePassword" id="RePassword" type="password" value="@Model.RePassword" />

            </div>
            <div class="form-group">
                <input type="checkbox" id="showPasswordCheck" onclick="togglePasswordVisibility()" />
                <label for="showPasswordCheck" id="showPasswordChecklbl">Hiển thị mật khẩu</label>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
            <span asp-validation-for="RePassword" class="text-danger"></span>
            <!-- Button Group -->
            <div class="modal-buttons">
                <button type="submit" id="btnSubmitChangePassword" onclick="submitChangePassword(event)">
                    Đồng ý
                </button>
                <button type="button" onclick="cancelChangePassword()">Hủy</button>
            </div>
        </div>
    </div>
</form>