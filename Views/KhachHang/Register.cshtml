@model RegisterVM
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản | JoneBookShop";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <script src="~/js/scriptRegister.js" asp-append-version="true"></script>
    }
    <script>
        $(document).ready(function () {
            $("form").validate({
                onfocusout: function (element) {
                    this.element(element);
                }
            });
        });
    </script>
}
@section Styles {
    <style>
        .text-danger {
            color: red;
            font-weight: bold;
        }
    </style>
}
<header>Signup Form</header>
<div class="progress-bar">
    <div class="step">
        <p>Name</p>
        <div class="bullet">
            <span>1</span>
        </div>
        <div class="check fas fa-check"></div>
    </div>
    <div class="step">
        <p>Contact</p>
        <div class="bullet">
            <span>2</span>
        </div>
        <div class="check fas fa-check"></div>
    </div>
    <div class="step">
        <p>Birth</p>
        <div class="bullet">
            <span>3</span>
        </div>
        <div class="check fas fa-check"></div>
    </div>
    <div class="step">
        <p>Submit</p>
        <div class="bullet">
            <span>4</span>
        </div>
        <div class="check fas fa-check"></div>
    </div>
</div>

<div class="form-outer">
    <form asp-action="Register">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="page slide-page">
            <div class="title">Basic Info:</div>
            <div class="field">
                <div class="label"><label asp-for="Name" for="name"></label></div>
                <input asp-for="Name" id="name" class="form-control" oninput="enableButton1()" />
            </div>
            <span class="text-danger" id="span1" asp-validation-for="Name"></span>
            <div class="field btns">
                <button class="prev" onclick="location.href='@Url.Action("Login", "KhachHang")'" type="button">Back</button>
                <button class="firstNext next" id="nextButton1" type="button" disabled>Next</button>
            </div>
        </div>

        <div class="page">
            <div class="title">Contact Info:</div>
            <div class="field">
                <div class="label"><label asp-for="Email" for="email"></label></div>
                <input asp-for="Email" id="email" class="form-control" oninput="enableButton2()" />
            </div>
            <div class="field">
                <div class="label"><label asp-for="Phones" for="phones"></label></div>
                <input asp-for="Phones" id="phones" class="form-control" oninput="enableButton2()" />
            </div>
            <span class="text-danger" id="span2" asp-validation-for="Email"></span><br />
            <span class="text-danger" id="span3" asp-validation-for="Phones"></span>
            <div class="field btns">
                <button class="prev-1 prev">Previous</button>
                <button class="next-1 next" id="nextButton2" type="button" disabled>Next</button>
            </div>
        </div>


        <div class="page">
            <div class="title">Date of Birth:</div>
            <div class="field">
                <div class="label"><label asp-for="Birthday" for="birthday"></label></div>
                <input asp-for="Birthday" id="birthday" class="form-control" type="date" oninput="enableButton3()" />
            </div>
            <div class="field">
                <div class="label"><label asp-for="Address" for="address"></label></div>
                <input asp-for="Address" id="address" class="form-control" oninput="enableButton3()" />
            </div>
            <span class="text-danger" id="span4" asp-validation-for="Birthday"></span><br />
            <span class="text-danger" id="span5" asp-validation-for="Address"></span>
            <div class="field btns">
                <button class="prev-2 prev">Previous</button>
                <button class="next-2 next" type="button" id="nextButton3" disabled>Next</button>
            </div>
        </div>

        <div class="page">
            <div class="title">Login Details:</div>
            <div class="field">
                <div class="label"><label asp-for="UserName" for="username"></label></div>
                <input asp-for="UserName" id="username" class="form-control" oninput="enableButton4()" />
            </div>
            <div class="field">
                <div class="label"><label asp-for="Password" for="password"></label></div>
                <input asp-for="Password" id="password" type="password" oninput="enableButton4()" class="form-control" />
            </div>
            <span class="text-danger" id="span6" asp-validation-for="UserName"></span><br />
            <span class="text-danger" id="span7" asp-validation-for="Password"></span>
            <div class="field btns">
                <button class="prev-3 prev">Previous</button>
                <button class="submit" id="submitButton" type="submit" value="Register" disabled>Submit</button>
            </div>
        </div>
    </form>
</div>




