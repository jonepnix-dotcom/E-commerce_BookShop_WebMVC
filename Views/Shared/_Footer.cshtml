
<!-- ##### Footer Area Start ##### -->
<footer class="footer_area clearfix">
    <div class="container">
        <div class="row align-items-center">
            <!-- Single Widget Area -->
            <div class="col-12 col-lg-4">
                <div class="single_widget_area">
                    <!-- Logo -->
                    <div class="footer-logo mr-50">
                        <img src="~/img/logo1.png" alt="Logo JoneBookShop">
                    </div>
                </div>
            </div>
            <!-- Single Widget Area -->
            <div class="col-12 col-lg-8">
                <div class="single_widget_area">
                    <!-- Footer Menu -->
                    <div class="footer_menu">
                        <nav class="navbar navbar-expand-lg justify-content-end">
                            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#footerNavContent" aria-controls="footerNavContent" aria-expanded="false" aria-label="Toggle navigation"><i class="fa fa-bars"></i></button>
                            <div class="collapse navbar-collapse" id="footerNavContent">
                                <ul class="navbar-nav ml-auto">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Books" asp-action="Index">Trang Chủ</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Books" asp-action="Shop">Cửa Hàng</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="ShopCart" asp-action="Index">Giỏ Hàng</a>
                                    </li>
                                    @if (User?.Identity?.IsAuthenticated == true)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link" asp-controller="KhachHang" asp-action="Profile">Tài khoản</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" asp-controller="KhachHang" asp-action="Logout">Đăng xuất</a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link" asp-controller="KhachHang" asp-action="Login">Đăng nhập</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </nav>
                        <p>Website phục vụ mục đích học tập, không kinh doanh mua bán! Nội dung và hình ảnh được tham khảo từ Fahasa</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
<!-- ##### Footer Area End ##### -->