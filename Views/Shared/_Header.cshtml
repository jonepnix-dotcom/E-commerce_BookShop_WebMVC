
<!-- Header Area Start -->
<header class="header-area clearfix">
    <!-- Close Icon -->
    <div class="nav-close">
        <i class="fa fa-close" aria-hidden="true"></i>
    </div>
    <!-- Logo -->
    <div class="logo">
        <img src="~/img/logo1.png" alt="Logo JoneBookShop">
    </div>
    <!-- Amado Nav -->
    <nav class="amado-nav">
        <ul>
            <li><a asp-controller="Books" asp-action="Index">Trang Chủ</a></li>
            <li><a asp-controller="Books" asp-action="Shop">Cửa Hàng</a></li>
            <li><a asp-controller="ShopCart" asp-action="Index">Giỏ Hàng</a></li>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <li><a asp-controller="KhachHang" asp-action="Profile">Tài khoản</a></li>
                <li><a asp-controller="KhachHang" asp-action="Logout">Đăng xuất</a></li>
            }
            else
            {
                <li>
                    <a asp-controller="KhachHang" asp-action="Login">Đăng nhập</a>
                </li>
            }

        </ul>
    </nav>

    <!-- Cart Menu -->
    <div class="cart-fav-search mb-100">
        <a href="#" class="search-nav"><img src="~/img/core-img/search.png" alt="Icon Search"> Tìm Kiếm</a>
    </div>
</header>
<!-- Header Area End -->